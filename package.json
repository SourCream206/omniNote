{
  "name": "omninote",
  "private": true,
  "version": "0.0.1",
  "description": "Local-first infinite canvas notebook app",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && vite build",
    "start": "npm run build && electron .",
    "ink-lab": "tsc -p tsconfig.json && electron . --ink-lab",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "node scripts/test-storage.cjs && node scripts/document-fixtures.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0"
  }
}

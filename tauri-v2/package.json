    "start": "tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3"
  }
}

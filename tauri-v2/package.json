{
  "name": "omninote-tauri",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix .. run dev:tauri",
    "predev:ink-lab": "node scripts/make-fixture.cjs",
    "dev:ink-lab": "vite",
    "build": "npm --prefix .. run build:tauri",
    "prebuild:ink-lab": "node scripts/make-fixture.cjs",
    "build:ink-lab": "tsc --noEmit && vite build",
    "test": "tsc src/rendering.ts --target ES2022 --module ESNext --moduleResolution Bundler --outDir .test-build --skipLibCheck && node --test tests/rendering.test.mjs",
    "tauri": "tauri",
    "start": "tauri dev",
    "start:ink-lab": "tauri dev --config src-tauri/tauri.ink-lab.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3"
  }
}

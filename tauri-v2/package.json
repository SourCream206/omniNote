{
  "name": "ink-lab-tauri-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/make-fixture.cjs",
    "dev": "vite",
    "prebuild": "node scripts/make-fixture.cjs",
    "build": "tsc --noEmit && vite build",

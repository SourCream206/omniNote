{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ink Lab",
  "version": "0.0.0",
  "identifier": "dev.notebook.inklab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Ink Lab — Tauri v2", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'" }
  },
  "bundle": { "active": false }
}

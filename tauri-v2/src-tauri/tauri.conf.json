{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omniNote",
  "version": "0.1.6",
  "identifier": "com.sourcream206.omninote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420/tauri.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist-tauri"
  },
  "app": {
    "windows": [{ "title": "omniNote", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 650, "decorations": false, "maximized": true, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost blob:; frame-src 'self' blob:; object-src 'none'" }
  },
  "bundle": { "active": true, "createUpdaterArtifacts": true, "icon": ["icons/icon.png", "icons/icon.ico"] },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMjA0MUM3RURGMjRGRjcKUldUM1QvTHR4MEVnNEpkTjdYMmF6dzJzQjlYSUIvZU15elQ4T05NT2pLUlZmNTFobHQzdnN4Q3IK",
      "endpoints": ["https://github.com/SourCream206/omniNote/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
